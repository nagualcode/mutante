uuid = "c641fb82-e223-5ac5-bd5e-9a0993924998"
name = "Square Echo Repeat"
category = "Manual"
author = "Jardim Sonoro"
comment = "Square sweep at a moderate rate with feedback up: the phasing jumps like an echo repeat."
tags = ["square", "rhythmic"]
default = false

[params]
gen_1_rate = 2.0
gen_1_sync = 0
gen_1_synced_rate = 6
gen_1_shape = 1
gen_1_rate_ctrl = 0
gen_2_rate = 1.6
gen_2_sync = 0
gen_2_synced_rate = 6
gen_2_shape = 0
phasor_a_depth = 10.0
phasor_a_feedback = 9.0
phasor_a_sweep = 0
phasor_a_on = 1
phasor_b_depth = 10.0
phasor_b_feedback = 9.0
phasor_b_sweep = 0
phasor_b_sweep_sync = 1
phasor_b_on = 1
routing = 0
pedal_position = 0.5
pedal_mode = 0
pedal_sensitivity = 2.0
input_level = 0.0
mix = 1.0
output_gain = 0.0
bypass = 0
